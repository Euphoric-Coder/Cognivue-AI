# ==============================================================================
# Cognivue AI - Environment Configuration Template
# Copy this file to .env.local (frontend) and backend/.env (Python engine)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend & Client Authentication (Next.js / Clerk)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key_here
CLERK_SECRET_KEY=sk_test_placeholder_key_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ------------------------------------------------------------------------------
# 2. Convex Database & Realtime State
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CONVEX_URL=https://your-convex-deployment.convex.cloud
CONVEX_DEPLOYMENT=dev:your-convex-deployment
CONVEX_SITE_URL=https://your-convex-deployment.convex.site

# ------------------------------------------------------------------------------
# 3. Python FastAPI Ingestion & Tutoring Service
# ------------------------------------------------------------------------------
INGESTION_API_URL=http://127.0.0.1:8000
INGESTION_API_SECRET=your_secure_random_internal_api_secret

# ------------------------------------------------------------------------------
# 4. Google Gemini API (Multimodal AI & Embeddings)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSyPlaceholderGeminiAPIKeyHere

# Optional Model Configuration Overrides
LLM_MODEL=gemini-3.6-flash
EMBEDDING_MODEL=gemini-embedding-2
VISION_MODEL=gemini-2.5-flash

# Optional RAG & Visual Extraction Tuning
RAG_TOP_K=8
RAG_FINAL_CONTEXT_COUNT=5
VISUAL_MAX_PER_SOURCE=25
VIDEO_MAX_KEYFRAMES=15

# Optional Production CORS (comma-separated origins or * for dev)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
